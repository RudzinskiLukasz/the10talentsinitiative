# Zenith Bank transfer details (shown on /donations)
# Optional — defaults are baked into the build; set these to override.
VITE_ZENITH_ACCOUNT_NAME=THE TEN TALENT HUMANITARIAN INITIATIVE
VITE_ZENITH_ACCOUNT_NUMBER=1312265547
VITE_ZENITH_BANK_NAME=Zenith Bank
# Optional — Nigerian bank sort code / NIB if applicable
VITE_ZENITH_SORT_CODE=

# Online payments (optional — no monthly fee; per-transaction only)
# Create a free Paystack account, link Zenith Bank as settlement account,
# then paste your public key (pk_test_… or pk_live_…).
VITE_PAYSTACK_PUBLIC_KEY=

# Alternative gateway (optional; not used when Paystack key is set)
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Contact form → Gmail (Web3Forms)
# Create a free access key at https://web3forms.com using thetentalentsinitiative@gmail.com
# (or another inbox). Paste the key below — it is safe to expose in the client bundle.
VITE_WEB3FORMS_ACCESS_KEY=

# Google Calendar embed on /events (optional override; defaults to site Gmail)
# VITE_GOOGLE_CALENDAR_ID=thetentalentsinitiative@gmail.com
# VITE_GOOGLE_CALENDAR_TIMEZONE=Africa/Lagos

# Supabase (posts CMS + T-Talents Records + admin panel at /admin)
# Create a project at https://supabase.com — then run:
#   supabase/migrations/001_posts.sql
#   supabase/migrations/002_tracks.sql
# in the SQL Editor. Create admin users under Authentication → Users.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Seed script only (never expose in the Vite client / Render static env):
# SUPABASE_SERVICE_ROLE_KEY=
