{
  "name": "the10talentsinitiatives",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing page for The Ten Talents Initiative — empowering Catholic youth to nurture their God-given gifts.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "serve -s build -l $PORT",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run test:run && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "i18next": "^26.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.1",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
